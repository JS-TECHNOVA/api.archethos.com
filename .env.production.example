# ── Archethos API — production ────────────────────────────────────────────────
# Copy to /var/www/api.archethos.com/.env, fill in, then:  chmod 600 .env
#
# ⚠️ No "$" in any value. docker-compose is not used in production, but the same
# file is read in development where it is, and a mangled SECRET_KEY is a very
# confusing failure. Generate keys with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"

DEBUG=False
SECRET_KEY=CHANGE-ME-generate-a-new-one-do-not-reuse-the-development-key
ALLOWED_HOSTS=api.archethos.com
DJANGO_SETTINGS_MODULE=archethosbackend.settings.production

# ── Database (native postgres on this host) ───────────────────────────────────
DB_NAME=archethos
DB_USER=archethos
DB_PASSWORD=CHANGE-ME
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# ── The Next.js frontend ──────────────────────────────────────────────────────
# Credentialed CORS forbids a wildcard, so every origin is listed explicitly.
CORS_ALLOWED_ORIGINS=https://archethos.com,https://www.archethos.com
CSRF_TRUSTED_ORIGINS=https://archethos.com,https://www.archethos.com,https://api.archethos.com

# ── Auth cookies ──────────────────────────────────────────────────────────────
# api.archethos.com and archethos.com share the registrable domain, so they are
# same-site and Lax works — the browser sends the cookie on the frontend's XHR.
# Only switch to None if the frontend ever moves to a different domain, and note
# that None requires Secure.
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=Lax
# Scopes the auth, CSRF and session cookies. The frontend is on archethos.com
# and the API on api.archethos.com, so this must be the shared parent domain —
# a host-only csrftoken cannot be read by JavaScript on the frontend, and every
# unsafe request then fails CSRF.
#
# Leave it empty only when the frontend and API share one host.
AUTH_COOKIE_DOMAIN=.archethos.com
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Media ─────────────────────────────────────────────────────────────────────
MEDIA_URL=/media/
MAX_UPLOAD_SIZE_MB=20

# ── Misc ──────────────────────────────────────────────────────────────────────
# Dates in the admin (created_after/created_before) are compared in this zone.
TIME_ZONE=Asia/Kolkata
LOG_LEVEL=INFO
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ─── Cache ───────────────────────────────────────────────────────────────────
# Rate limit counters live here, so it MUST be shared between gunicorn workers.
# Production refuses to boot on a per-process cache: three workers keeping three
# counters makes every limit three times what it says.
#
# dbcache uses the Postgres already in the stack. Create the table once:
#   manage.py createcachetable
CACHE_URL=dbcache://django_cache

# ─── Rate limiting ───────────────────────────────────────────────────────────
# Format: <count>/<period>  —  5/m, 10/5m, 100/h, 1000/d.
# Leave a value empty to switch that one limit off.
RATELIMIT_ENABLE=True

# ⚠️ Behind Cloudflare this is not optional. nginx appends its own peer to
# X-Forwarded-For, which behind the proxy is a Cloudflare edge IP — so without
# this every visitor arriving through one edge would share a single bucket.
#
# CF-Connecting-IP cannot be forged *through* Cloudflare, but it can by anyone
# who reaches the origin directly. Restrict ports 80/443 to Cloudflare's
# published ranges before relying on it.
RATELIMIT_TRUSTED_IP_HEADER=HTTP_CF_CONNECTING_IP

# Only failed sign-ins count against these; a working password costs nothing.
RATELIMIT_LOGIN_IP=10/5m
RATELIMIT_LOGIN_USER=5/15m
RATELIMIT_REFRESH=60/h
RATELIMIT_PASSWORD_CHANGE=5/h
RATELIMIT_ENQUIRY=10/h
